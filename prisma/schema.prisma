// =============================================================================
// prisma/schema.prisma — RTS (Request Tracking System)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Requestor
  RM
  HOD
  DeptHOD
  Management
  Admin
  HR
  FoodCommittee
  Intern
  SuperUser
  ViewCloseTicket
}

enum MessageType {
  message
  file
  voice
  mixed
  approval
  system
}

model User {
  id           String   @id @default(uuid())
  empId        String   @unique @map("emp_id")
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(Requestor)
  dept         String
  designation  String?
  location     String?
  isActive     Boolean  @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  lastSeen     DateTime? @map("last_seen")
  createdAt    DateTime @default(now()) @map("created_at")

  rmEmpId      String?  @map("rm_emp_id")
  hodEmpId     String?  @map("hod_emp_id")

  resetPasswordToken   String?   @unique @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")

  rm           User?    @relation("UserRM",  fields: [rmEmpId],  references: [empId], onDelete: SetNull)
  hod          User?    @relation("UserHOD", fields: [hodEmpId], references: [empId], onDelete: SetNull)
  rmReports    User[]   @relation("UserRM")
  hodReports   User[]   @relation("UserHOD")

  requests          Request[]          @relation("RequestOwner")
  messages          ChatMessage[]      @relation("MessageSender")
  readReceipts      RequestRead[]
  chatReads         ChatRead[]
  loginLogs         LoginLog[]
  foodSubscription  FoodSubscription?
  foodCancellations FoodCancellation[]
  foodManualEntries FoodManualEntry[]
  userRoles         UserRole[]
  pushSubscriptions PushSubscription[]
  fcmTokens         FcmToken[]

  @@map("users")
}

model UserRole {
  id       Int     @id @default(autoincrement())
  empId    String  @map("emp_id")
  role     Role
  dept     String
  isActive Boolean @default(true) @map("is_active")

  user     User    @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@unique([empId, role, dept])
  @@map("user_roles")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  empId     String   @map("emp_id")
  loginAt   DateTime @default(now()) @map("login_at")
  logoutAt  DateTime? @map("logout_at")
  duration  Int?     @default(0) // Duration in minutes

  user      User     @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@index([empId])
  @@map("login_logs")
}

model Request {
  id             Int       @id @default(autoincrement())
  empId          String    @map("emp_id")
  purpose        String
  description    String?
  fileUrl        String?   @map("file_url")
  fileName       String?   @map("file_name")
  fileUrls       String?   @map("file_urls")
  fileNames      String?   @map("file_names")
  dept           String
  assignedDept   String    @map("assigned_dept")
  requestorRole  String?   @map("requestor_role")
  rmStatus       String    @default("--") @map("rm_status")
  rmDate         DateTime? @map("rm_date")
  hodStatus      String    @default("--") @map("hod_status")
  hodDate        DateTime? @map("hod_date")
  deptHodStatus  String    @default("--") @map("dept_hod_status")
  deptHodDate    DateTime? @map("dept_hod_date")

  // Management portal approval (separate from DeptHOD so both can act independently)
  managementStatus String    @default("--") @map("management_status")
  managementDate   DateTime? @map("management_date")

  // Assigned dept RM/HOD approval (separate from requestor's dept RM/HOD)
  assignedRmStatus  String    @default("--") @map("assigned_rm_status")
  assignedRmDate    DateTime? @map("assigned_rm_date")
  assignedHodStatus String    @default("--") @map("assigned_hod_status")
  assignedHodDate   DateTime? @map("assigned_hod_date")

  forwarded      Boolean   @default(false)
  forwardedBy    String?   @map("forwarded_by")
  forwardedAt    DateTime? @map("forwarded_at")
  assignedStatus      String    @default("Open") @map("assigned_status")
  isClosed            Boolean   @default(false) @map("is_closed")
  resolvedDate        DateTime? @map("resolved_date")
  resolvedBy          String?   @default("-") @map("resolved_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  // Due date & priority
  dueDate             DateTime? @map("due_date")

  // Assigned departments (comma-separated, from multi-dept selection)
  assignedDepts       String?   @map("assigned_depts")

  // Assigned person (from multi-dept selection)
  assignedPersonEmpId String?   @map("assigned_person_emp_id")
  assignedPersonName  String?   @map("assigned_person_name")
  // True only when requestor explicitly picked this person in Add Request
  isDirectAssign      Boolean   @default(false) @map("is_direct_assign")

  // CC (Copy To) — receives the ticket, can view and chat, cannot take action
  ccDepts       String?   @map("cc_depts")
  ccEmpIds      String?   @map("cc_emp_ids")
  ccPersonNames String?   @map("cc_person_names")

  // Checking deadline (set when someone clicks Checking)
  checkingDeadline    DateTime? @map("checking_deadline")
  checkingReason      String?   @map("checking_reason")
  checkingBy          String?   @map("checking_by")

  // Requestor acknowledgement (after ticket is closed)
  acknowledgement     String?   @map("acknowledgement")
  acknowledgedAt      DateTime? @map("acknowledged_at")

  // Recurring request settings
  isRecurring        Boolean   @default(false) @map("is_recurring")
  recurringInterval  String?   @map("recurring_interval")  // "1m" | "4m" | "6m" | "1y"
  nextRecurringDate  DateTime? @map("next_recurring_date")
  recurringParentId  Int?      @map("recurring_parent_id")

  // Reopen tracking
  reopenedAt         DateTime? @map("reopened_at")

  owner        User          @relation("RequestOwner", fields: [empId], references: [empId])
  chatMessages ChatMessage[]
  closeTicket  CloseTicket?
  readReceipts RequestRead[]
  chatReads    ChatRead[]

  @@index([empId])
  @@index([assignedDept])
  @@map("requests")
}

model RequestRead {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  empId     String   @map("emp_id")
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@unique([requestId, empId])
  @@map("request_reads")
}

model ChatRead {
  requestId  Int      @map("request_id")
  empId      String   @map("emp_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [empId],    references: [empId], onDelete: Cascade)

  @@id([requestId, empId])
  @@map("chat_reads")
}

model CloseTicket {
  id          Int      @id @default(autoincrement())
  requestId   Int      @unique @map("request_id")
  description String?
  fileUrl     String?  @map("file_url")
  fileName    String?  @map("file_name")
  fileUrls    String?  @map("file_urls")
  fileNames   String?  @map("file_names")
  closedDate  DateTime @default(now()) @map("closed_date")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("close_tickets")
}

model ChatMessage {
  id           Int         @id @default(autoincrement())
  requestId    Int         @map("request_id")
  authorId     String?     @map("author_id")
  author       String
  role         String
  dept         String?
  type         MessageType @default(message)
  text         String?     @default("")
  fileUrl      String?     @map("file_url")
  fileName     String?     @map("file_name")
  isImage      Boolean     @default(false) @map("is_image")
  voiceUrl     String?     @map("voice_url")
  duration     String?
  replyTo      String?     @map("reply_to")
  status       String?
  purpose      String?
  changedDept  String?     @map("changed_dept")
  originalDept String?     @map("original_dept")
  createdAt    DateTime    @default(now()) @map("created_at")

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender   User?   @relation("MessageSender", fields: [authorId], references: [empId])

  @@index([requestId])
  @@map("chat_messages")
}

model FoodSubscription {
  id            Int       @id @default(autoincrement())
  empId         String    @unique @map("emp_id")
  isActive      Boolean   @default(true) @map("is_active")
  suspendedFrom DateTime? @map("suspended_from")
  startDate     DateTime  @default(now()) @map("start_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@map("food_subscriptions")
}

model FoodCancellation {
  id            Int      @id @default(autoincrement())
  empId         String   @map("emp_id")
  weekStartDate DateTime @map("week_start_date")
  cancelledAt   DateTime @default(now()) @map("cancelled_at")

  user User @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@unique([empId, weekStartDate])
  @@index([empId])
  @@map("food_cancellations")
}

model FoodManualEntry {
  id            Int      @id @default(autoincrement())
  empId         String   @map("emp_id")
  weekStartDate DateTime @map("week_start_date")
  amount        Float
  note          String?
  addedByEmpId  String   @map("added_by_emp_id")
  addedByName   String   @map("added_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@unique([empId, weekStartDate])
  @@index([empId])
  @@map("food_manual_entries")
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique
  name String

  @@map("holidays")
}

model PushSubscription {
  id        String   @id @default(uuid())
  empId     String   @map("emp_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@index([empId])
  @@map("push_subscriptions")
}

model FcmToken {
  id        String   @id @default(uuid())
  empId     String   @map("emp_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@index([empId])
  @@map("fcm_tokens")
}
  